{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.markkkkkkkkkkkkkkkk/stealth-scraper-mcp",
  "title": "Stealth Web Scraper",
  "description": "Scrape any web page into clean Markdown, with query-focused passages and a real-Chrome fallback.",
  "version": "0.4.0",
  "repository": {
    "url": "https://github.com/markkkkkkkkkkkkkkkk/stealth-scraper-mcp",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "stealth-scraper-mcp",
      "version": "0.4.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "SCRAPER_PROXY_URL",
          "description": "Optional upstream proxy, e.g. http://user:pass@host:port",
          "isRequired": false,
          "isSecret": true
        }
      ]
    }
  ]
}
